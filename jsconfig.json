{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "pages/**/*",
    "components/**/*",
    "layouts/**/*",
    "plugins/**/*",
    "assets/**/*",
    "store/**/*",
    "nuxt.config.js",
    "*.js",
    "**/*.vue"
  ],
  "exclude": [
    "node_modules",
    ".nuxt",
    ".history",
    "dist"
  ]
}
